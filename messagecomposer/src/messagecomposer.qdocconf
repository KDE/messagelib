    messagecomposer_qdocmoduleheader.h \
    part/globalpart.h \
    part/infopart.h \
    part/itippart.h \
    part/messagepart.h \
    part/textpart.h \
    plugineditor/pluginactiontype.h \
    plugineditor/plugincomposerinterface.h \
    plugineditor/plugineditor.h \
