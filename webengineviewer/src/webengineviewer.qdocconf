include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = WebEngineViewer
moduleheader = webengineviewer_qdocmoduleheader.h
description = WebEngineViewer provides WebEngineViewer Library.


documentationinheaders = true

headers += \
    checkphishingurl/checkphishingurlcache.h \
    checkphishingurl/checkphishingurljob.h \
    checkphishingurl/checkphishingurlutil.h \
    checkphishingurl/createphishingurldatabasejob.h \
    checkphishingurl/hashcachemanager.h \
    checkphishingurl/localdatabasemanager.h \
    checkphishingurl/searchfullhashjob.h \
    checkphishingurl/updatedatabaseinfo.h \
    developertool/developertooldialog.h \
    findbar/findbarbase.h \
    findbar/findbarwebengineview.h \
    networkmanager/interceptormanager.h \
    urlinterceptor/blockexternalresourcesurlinterceptor/blockexternalresourcesurlinterceptor.h \
    urlinterceptor/blocktrackingurlinterceptor/blocktrackingurlinterceptor.h \
    urlinterceptor/loadexternalreferencesurlinterceptor/loadexternalreferencesurlinterceptor.h \
    urlinterceptor/networkpluginurlinterceptor.h \
    urlinterceptor/networkpluginurlinterceptorconfigurewidget.h \
    urlinterceptor/networkpluginurlinterceptorinterface.h \
    urlinterceptor/networkurlinterceptor.h \
    urlinterceptor/networkurlinterceptorpluginmanager.h \
    webengineaccesskey/webengineaccesskey.h \
    webengineexportpdfpagejob.h \
    webenginemanagescript.h \
    webenginepage.h \
    webenginescript.h \
    webengineview.h \
    webengineviewer_qdocmoduleheader.h \
    webhittest.h \
    webhittestresult.h \
    widgets/submittedformwidgets/submittedformwarningwidget.h \
    widgets/tracking/trackingwarningwidget.h \
    widgets/zoomactionmenu.h
sourcedirs += .

excludedirs += \
    autotests \
    checkphishingurl/autotests \
    checkphishingurl/tests \
    developertool/autotests \
    findbar/autotests \
    tests \
    urlinterceptor/blockexternalresourcesurlinterceptor/autotests \
    urlinterceptor/blocktrackingurlinterceptor/autotests \
    webengineaccesskey/autotests \
    widgets/tracking/autotests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "WebEngineViewer"

qhp.projects            = webengineviewer

qhp.webengineviewer.file                = webengineviewer.qhp
qhp.webengineviewer.namespace           = org.kde.webengineviewer.$QT_VERSION_TAG
qhp.webengineviewer.virtualFolder       = webengineviewer
qhp.webengineviewer.indexTitle          = WebEngineViewer
qhp.webengineviewer.indexRoot           =

qhp.webengineviewer.subprojects         = classes
qhp.webengineviewer.subprojects.classes.title = C++ Classes
qhp.webengineviewer.subprojects.classes.indexTitle = WebEngineViewer C++ Classes
qhp.webengineviewer.subprojects.classes.selectors = class fake:headerfile
qhp.webengineviewer.subprojects.classes.sortPages = true

tagfile = webengineviewer.tags
