include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = MessageCore
moduleheader = messagecore_qdocmoduleheader.h
description = MessageCore provides MessageCore Library.


documentationinheaders = true

headers += \
    attachment/attachmentcompressjob.h \
    attachment/attachmentfromurlbasejob.h \
    attachment/attachmentfromurlutils.h \
    attachment/attachmentloadjob.h \
    attachment/attachmentpart.h \
    attachment/attachmentpropertiesdialog.h \
    attachment/attachmentupdatejob.h \
    autocrypt/autocryptrecipient.h \
    autocrypt/autocryptstorage.h \
    autocrypt/autocryptutils.h \
    dkim-verify/dkimcheckpolicy.h \
    dkim-verify/dkimchecksignaturejob.h \
    dkim-verify/dkimheaderparser.h \
    dkim-verify/dkiminfo.h \
    dkim-verify/dkimkeyrecord.h \
    dkim-verify/dkimmanager.h \
    dkim-verify/dkimmanagerauthenticationserver.h \
    dkim-verify/dkimmanagerkey.h \
    dkim-verify/dkimmanagerrules.h \
    dkim-verify/dkimrule.h \
    dkim-verify/dmarcinfo.h \
    dkim-verify/dmarcpolicyjob.h \
    messagecore_qdocmoduleheader.h \
    misc/imagecollector.h \
    misc/mailinglist.h \
    settings/messagecoresettings.h \
    utils/colorutil.h \
    utils/dateformatter.h \
    utils/stringutil.h \
    utils/util.h
sourcedirs += .

excludedirs += \
    dkim-verify/autotests \
    dkim-verify/tests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "MessageCore"

qhp.projects            = messagecore

qhp.messagecore.file                = messagecore.qhp
qhp.messagecore.namespace           = org.kde.messagecore.$QT_VERSION_TAG
qhp.messagecore.virtualFolder       = messagecore
qhp.messagecore.indexTitle          = MessageCore
qhp.messagecore.indexRoot           =

qhp.messagecore.subprojects         = classes
qhp.messagecore.subprojects.classes.title = C++ Classes
qhp.messagecore.subprojects.classes.indexTitle = MessageCore C++ Classes
qhp.messagecore.subprojects.classes.selectors = class fake:headerfile
qhp.messagecore.subprojects.classes.sortPages = true

tagfile = messagecore.tags
